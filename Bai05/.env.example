# Sao chép thành .env (cùng cấp docker-compose.yml). Docker Compose đọc file .env tự động.
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# Spring Boot chạy trên máy Windows: đặt cùng cổng với mapping Docker (14333) — ví dụ trong PowerShell trước khi mvnw:
#   $env:MSSQL_PORT = "14333"
#   $env:MSSQL_SA_PASSWORD = "YourStrong@Passw0rd"
# (Hoặc chỉnh MSSQL_PORT trong IDE Run configuration.)
