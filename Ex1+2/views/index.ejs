<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-base-200 min-h-screen flex flex-col items-center justify-center p-4">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full max-w-5xl">

        <!-- Producer Card -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
                <h2 class="card-title justify-center mb-4">🐰 RabbitMQ Producer</h2>

                <% if (status) { %>
                    <div role="alert"
                        class="alert <%= status.startsWith('Error') || status === 'Queue is empty!' ? 'alert-error' : 'alert-success' %> mb-4">
                        <span>
                            <%= status %>
                        </span>
                    </div>
                    <% } %>

                        <form action="/send" method="POST" class="form-control gap-4">
                            <div>
                                <label class="label">
                                    <span class="label-text">Message Content</span>
                                </label>
                                <input type="text" name="message" placeholder="Type here..."
                                    class="input input-bordered w-full" required />
                            </div>

                            <button type="submit" class="btn btn-primary w-full mt-1">Send Message</button>
                        </form>
            </div>
        </div>

        <!-- Consumer / Inspector Card -->
        <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
                <h2 class="card-title justify-center mb-4">👀 Queue Inspector & Consumer</h2>

                <div class="flex gap-2 mb-4">
                    <!-- GET Button -->
                    <form action="/get" method="GET" class="flex-1">
                        <button type="submit" class="btn btn-secondary w-full">Get / Peek Messages</button>
                    </form>

                    <!-- Consume Button -->
                    <form action="/consume" method="POST" class="flex-1">
                        <button type="submit" class="btn btn-accent w-full">Consume Next</button>
                    </form>
                </div>

                <div class="divider">Queue Content</div>

                <div class="overflow-x-auto h-64 border rounded-box bg-base-200">
                    <table class="table table-pin-rows">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Payload</th>
                                <th>Redelivered</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (messages && messages.length> 0) { %>
                                <% messages.forEach((msg, index)=> { %>
                                    <tr>
                                        <td>
                                            <%= index + 1 %>
                                        </td>
                                        <td class="font-mono text-xs">
                                            <%= msg.payload %>
                                        </td>
                                        <td>
                                            <%= msg.redelivered %>
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="3" class="text-center text-opacity-50 italic">Queue is
                                                    empty or not inspected</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-8 text-center text-sm opacity-70">
        <p>To start the background consumer worker:</p>
        <code class="bg-base-300 p-1 rounded">node consumer.js</code>
    </div>

</body>

</html>