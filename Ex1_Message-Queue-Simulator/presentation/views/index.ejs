<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RabbitMQ Simulator</title>
    <!-- Use a simple CSS framework for "premium" look -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Socket.io client library -->
    <script src="/socket.io/socket.io.js"></script>
</head>

<body class="bg-gray-100 min-h-screen p-8">
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden p-6">
        <h1 class="text-3xl font-bold mb-6 text-center text-indigo-600">Message Queue Simulator</h1>

        <!-- Input Form -->
        <form action="/send" method="POST" class="mb-8 space-y-4">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
                <input type="text" name="name" id="name" required
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border">
            </div>
            <div>
                <label for="message" class="block text-sm font-medium text-gray-700">Message</label>
                <input type="text" name="message" id="message" required
                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border">
            </div>
            <button type="submit"
                class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Send Message
            </button>
        </form>

        <hr class="my-6">

        <!-- Message List -->
        <div>
            <h2 class="text-xl font-semibold mb-4">Live Messages</h2>
            <ul id="messageList" class="space-y-3">
                <% messages.forEach(function(msg) { %>
                    <li class="p-3 bg-gray-50 rounded shadow-sm border-l-4 border-indigo-500 animate-pulse">
                        <span class="font-bold text-indigo-700">
                            <%= msg.name %>
                        </span>:
                        <span class="text-gray-800">
                            <%= msg.message %>
                        </span>
                        <span class="text-xs text-gray-500 ml-2">(<%= new Date(msg.createdTime).toLocaleTimeString() %>
                                )</span>
                    </li>
                    <% }); %>
            </ul>
        </div>
    </div>

    <!-- Script to handle Real-time updates -->
    <script>
        // Check if io is defined (it might not be if server hasn't set it up yet)
        if (typeof io !== 'undefined') {
            const socket = io();

            socket.on('new_message', function (data) {
                const list = document.getElementById('messageList');
                const li = document.createElement('li');
                li.className = 'p-3 bg-green-50 rounded shadow-sm border-l-4 border-green-500 transition duration-500 ease-in-out transform scale-100';

                // Format time (simple)
                const time = new Date(data.createdTime).toLocaleTimeString();

                li.innerHTML = `
                    <span class="font-bold text-green-700">${data.name}</span>: 
                    <span class="text-gray-800">${data.message}</span>
                    <span class="text-xs text-gray-500 ml-2">(${time})</span>
                `;

                // Prepend to list
                list.insertBefore(li, list.firstChild);
            });
        }
    </script>
</body>

</html>