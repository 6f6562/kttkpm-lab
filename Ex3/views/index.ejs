<!DOCTYPE html>
<html>

<head>
    <title>
        <%= title %>
    </title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="p-10 bg-base-200 min-h-screen">
    <div class="card bg-base-100 shadow-xl max-w-2xl mx-auto">
        <div class="card-body">
            <h1 class="card-title text-3xl mb-5">
                <%= title %>
            </h1>

            <% if (locals.message) { %>
                <div class="alert alert-success">
                    <span>
                        <%= message %>
                    </span>
                </div>
                <% } %>

                    <% if (locals.order) { %>
                        <div class="mockup-code mt-4 mb-4">
                            <pre data-prefix=">"><code>Order ID: <%= order.id %></code></pre>
                            <pre data-prefix=">"><code>Product: <%= order.product %></code></pre>
                            <pre data-prefix=">"><code>Email: <%= order.email %></code></pre>
                            <pre data-prefix=">"><code>Status: <%= order.status %></code></pre>
                        </div>
                        <% } %>

                            <div class="divider">Sync Order Form</div>

                            <form action="/order/sync" method="POST" class="form-control gap-4">
                                <div>
                                    <label class="label">
                                        <span class="label-text">Product Name</span>
                                    </label>
                                    <input type="text" name="product" placeholder="Enter product name"
                                        class="input input-bordered w-full" required />
                                </div>

                                <div>
                                    <label class="label">
                                        <span class="label-text">Email</span>
                                    </label>
                                    <input type="email" name="email" placeholder="Enter your email"
                                        class="input input-bordered w-full" required />
                                </div>

                                <button type="submit" class="btn btn-primary mt-4">Create Order (Sync)</button>
                            </form>

                            <div class="mt-4 text-sm opacity-70">
                                <p>Note: This is a synchronous flow. The request will take at least 3 seconds to
                                    complete.</p>
                            </div>
        </div>
    </div>
</body>

</html>